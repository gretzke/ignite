{
  "name": "@ignite/browser-wallet-plugin",
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit && mkdir -p dist && esbuild index.ts --bundle --platform=browser --target=es2022 --format=esm --minify --outfile=dist/index.js --define:PLUGIN_VERSION='\"'$(node -p \"require('./package.json').version\")'\"'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.8",
    "typescript": "^5.8.3"
  }
}
